{
  "manifest_version": 3,
  "name": "Poe Market Zh",
  "version": "329.5.15",
  "description": "PoE1 / PoE2 國際服交易站中文化、書籤側邊欄與物價查詢;可另開 poe.ninja / pobb.in 的角色、配裝與物價頁中文化",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Poe Market Zh — 交易站 / poe.ninja / pobb.in 中文輔助"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.pathofexile.com/*",
    "https://pathofexile.com/*",
    "https://pathofexile.tw/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://poe.ninja/*",
    "https://pobb.in/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/icons.json",
        "icons/folder/*.png"
      ],
      "matches": [
        "https://www.pathofexile.com/*",
        "https://pathofexile.com/*",
        "https://pathofexile.tw/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.pathofexile.com/trade/*",
        "https://pathofexile.com/trade/*",
        "https://www.pathofexile.com/trade2/*",
        "https://pathofexile.com/trade2/*"
      ],
      "js": [
        "page/trade-data.js",
        "page/ui-strings.js",
        "page/stat-search.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.pathofexile.com/trade/*",
        "https://pathofexile.com/trade/*",
        "https://www.pathofexile.com/trade2/*",
        "https://pathofexile.com/trade2/*",
        "https://pathofexile.tw/trade/*",
        "https://pathofexile.tw/trade2/*"
      ],
      "js": [
        "page/mod-filter.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.pathofexile.com/trade/*",
        "https://pathofexile.com/trade/*",
        "https://www.pathofexile.com/trade2/*",
        "https://pathofexile.com/trade2/*",
        "https://pathofexile.tw/trade/*",
        "https://pathofexile.tw/trade2/*"
      ],
      "js": [
        "content/bootstrap.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.pathofexile.com/trade/*",
        "https://pathofexile.com/trade/*",
        "https://www.pathofexile.com/trade2/*",
        "https://pathofexile.com/trade2/*",
        "https://pathofexile.tw/trade/*",
        "https://pathofexile.tw/trade2/*"
      ],
      "js": [
        "shared/i18n.js",
        "content/mod-row.js",
        "content/item-text.js",
        "content/copy-item.js",
        "content/results.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.pathofexile.com/trade/*",
        "https://pathofexile.com/trade/*",
        "https://www.pathofexile.com/trade2/*",
        "https://pathofexile.com/trade2/*",
        "https://pathofexile.tw/trade/*",
        "https://pathofexile.tw/trade2/*"
      ],
      "js": [
        "shared/i18n.js",
        "shared/i18n-sidebar.js",
        "content/bookmarks-model.js",
        "content/pob-import.js",
        "content/sidebar.js"
      ],
      "css": [
        "content/sidebar.css"
      ],
      "run_at": "document_end"
    }
  ]
}
