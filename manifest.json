{
  "manifest_version": 3,
  "name": "Poe Market Zh",
  "version": "329.5.1",
  "description": "PoE1 / PoE2 國際服交易站中文化:介面、詞綴、下拉選單中文化 + 搜尋結果即時翻譯,另附書籤側邊欄與物價查詢",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Poe Market Zh"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms"],
  "host_permissions": [
    "https://www.pathofexile.com/*",
    "https://pathofexile.com/*",
    "https://pathofexile.tw/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": ["https://poe.ninja/*"],
  "web_accessible_resources": [
    {
      "resources": ["data/icons.json"],
      "matches": ["https://www.pathofexile.com/*", "https://pathofexile.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.pathofexile.com/trade/*",
        "https://pathofexile.com/trade/*",
        "https://www.pathofexile.com/trade2/*",
        "https://pathofexile.com/trade2/*"
      ],
      "js": ["page/trade-data.js", "page/ui-strings.js", "page/stat-search.js", "page/mod-filter.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.pathofexile.com/trade/*",
        "https://pathofexile.com/trade/*",
        "https://www.pathofexile.com/trade2/*",
        "https://pathofexile.com/trade2/*"
      ],
      "js": ["content/bootstrap.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.pathofexile.com/trade/*",
        "https://pathofexile.com/trade/*",
        "https://www.pathofexile.com/trade2/*",
        "https://pathofexile.com/trade2/*"
      ],
      "js": ["content/mod-row.js", "content/results.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.pathofexile.com/trade/*",
        "https://pathofexile.com/trade/*",
        "https://www.pathofexile.com/trade2/*",
        "https://pathofexile.com/trade2/*"
      ],
      "js": ["content/bookmarks-model.js", "content/pob-import.js", "content/sidebar.js"],
      "css": ["content/sidebar.css"],
      "run_at": "document_end"
    }
  ]
}
